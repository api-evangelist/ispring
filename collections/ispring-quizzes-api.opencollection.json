{
  "opencollection": "1.0.0",
  "info": {
    "name": "Learn Rest Api assignments quizzes API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "quizzes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves a list of quizzes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-learn.ispring.com/quizzes",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query"
              },
              {
                "name": "quizIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "contentItemIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "parentCourseIds",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves a list of quizzes"
        },
        {
          "info": {
            "name": "Retrieves a paginated list of answers results for answer breakdown report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-learn.ispring.com/report/answer-breakdown",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query"
              },
              {
                "name": "quizId",
                "value": "",
                "type": "query"
              },
              {
                "name": "parentCourseId",
                "value": "",
                "type": "query"
              },
              {
                "name": "userIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "enrollmentIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "departmentIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "groupIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "attemptDate",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves a paginated list of answers results for answer breakdown report"
        }
      ]
    }
  ],
  "bundled": true
}